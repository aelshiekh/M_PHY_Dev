PYTHON = /usr/bin/python3 # Can be changed to adapt with the user's linux environment

clean:
	@rm -rf test.py # @ is added to Suppress echo of command invocation
toplevel:
	@${PYTHON} top_level.py -f wrapper
csv2excel:
	@${PYTHON} top_level.py -f csv2excel
excel2csv:
	@${PYTHON} top_level.py -f excel2csv
